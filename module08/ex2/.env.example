# Copy this file to .env and replace the placeholder values.
#   cp .env.example .env
# .env holds real credentials and is never committed.

# "development" or "production"
MATRIX_MODE=development

# Connection string for data storage
DATABASE_URL=postgresql://neo:changeme@localhost:5432/matrix

# Secret key for external services
API_KEY=your-api-key-here

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG

# URL for the resistance network
ZION_ENDPOINT=https://zion.local/api
